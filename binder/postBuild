#!/bin/bash
set -e

juliaup add release
which julia > juliacheck.log

packages=("AwkwardArray" "IJulia" "Geant4" "BAT" "CairoMakie" "Plots" "CSV")
packages+=("StatsBase" "BenchmarkTools" "Measurements" "OhMyThreads" "Unitful")
packages+=("TypedTables" "Distributions" "DistributionsHEP" "DataFrames")
packages+=("FHist" "GeometryBasics" "IGLWrap_jll" "LinearAlgebra" "Parameters")
packages+=("Printf" "Rotations" "StaticArrays" "Zygote" "StatsPlots")
packages+=("UnROOT" "QuadGK" "Optimization" "OptimizationLBFGSB" "ForwardDiff")
packages+=("DensityInterface" "ValueShapes" "IntervalSets", "Revise")

comm="["
for i in "${packages[@]}"
do
    comm+="\""$i"\","    
done
comm+="]"
echo $comm

julia -e 'using Pkg; Pkg.add('$comm')'

git clone https://github.com/JuliaHEP/Hands-on-Julia-for-particle-physicists

cd Hands-on-Julia-for-particle-physicists/
rm Project.toml
cd julia-intro/docs 

sed -i s/julia-1.11/julia-1.12/ *.ipynb
sed -i s/Julia-1.11.6/Julia-1.12/ *.ipynb
sed -i s/Julia-1.11.6/Julia-1.12/ */*.ipynb
sed -i s/julia-1.11/julia-1.12/ */*.ipynb
cd ..

jupyter-book build ./docs 

cd ../../
##############

git clone https://github.com/peremato/Geant4.jl-tutorial/

cd Geant4.jl-tutorial/
rm Project.toml
cd tutorial/docs 

sed -i s/julia-1.11/julia-1.12/ `find . -name \*.ipynb`
sed -i s/Julia-1.11.6/Julia-1.12/ `find . -name \*.ipynb`
cd ..
jupyter-book build ./docs

cd ../../
touch tutorials.html > tutorials.html
echo "<!DOCTYPE html>" >> tutorials.html
echo "<html>" >> tutorials.html
echo "  <head>" >> tutorials.html
echo "  </head>" >> tutorials.html
echo " " >> tutorials.html
echo "  <body>" >> tutorials.html
echo "    <h1>Julia tutorials</h1>" >> tutorials.html
echo "    <ul>" >> tutorials.html
echo "    <li> <a href="Hands-on-Julia-for-particle-physicists/julia-intro/docs/_build/html/index.html">Hands on intro</a>" >> tutorials.html
echo "    <li> <a href="Geant4.jl-tutorial/tutorial/docs/_build/html/index.html">Geant4 tutorial</a>" >> tutorials.html
echo "    </ul>"  >> tutorials.html
echo " " >> tutorials.html      
echo "  </body> " >> tutorials.html
echo "</html> " >> tutorials.html



